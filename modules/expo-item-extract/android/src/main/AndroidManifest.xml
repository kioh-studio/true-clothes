<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="expo.modules.itemextract">

    <!--
        ML Kit Subject Segmentation requires an on-device model. The bundled
        model variant (subject-segmentation:1.0.0-beta1) ships the model inside
        the APK, so no extra meta-data entry is required here for download.

        If you switch to the download-on-demand ("common") variant, add:

        <application>
            <meta-data
                android:name="com.google.mlkit.vision.DEPENDENCIES"
                android:value="subject_segment" />
        </application>
    -->

</manifest>
