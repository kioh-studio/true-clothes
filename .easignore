# .easignore — controls what gets uploaded into the EAS Build archive.
# Goal: ship only what the app needs at build time. Self-contained superset of
# .gitignore's heavy excludes PLUS dev-only/scratch files, so it is correct
# whether EAS treats this as a replacement for or an addition to .gitignore.

# --- Dependencies (EAS reinstalls on the build server) ---
node_modules/

# --- VCS / Expo / build output ---
.git/
.expo/
dist/
expo-env.d.ts

# --- Native build caches (EAS recompiles from scratch on the build server) ---
# These are covered by android/.gitignore, but .easignore REPLACES .gitignore for
# the upload archive, so they must be repeated here or ~2 GB of object files,
# unstripped .so and CMake caches get uploaded on every build.
android/build/
android/app/build/
android/app/.cxx/
android/.gradle/
modules/*/android/build/
modules/*/android/.cxx/
ios/build/
ios/Pods/

# --- Secrets: env is injected via eas.json build.*.env, never from .env ---
.env
.env.local

# --- OS / IDE cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Scratch artifacts & design exports (not referenced by app/ or src/) ---
*.zip
*.log
*.orig
*.stackdump
screens/
# Loose capture screenshots dropped into assets/ root (not referenced by code)
assets/[Cc]apture*.PNG

# --- Dev helper scripts (no EAS build hook references them) ---
scripts/

# --- Planning / spec docs (not needed at runtime) ---
specs/
docs/

# --- Tests & mocks (not part of the shipped app) ---
**/__tests__/
**/__mocks__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
jest.config.js

# --- Dev-only local-photo seeder + its screen (also __DEV__-guarded in source) ---
# Excluded as a consistent pair: dev-seed.tsx is the only importer of *.dev.ts,
# so removing both avoids any dangling import in the production bundle.
app/dev-seed.tsx
**/*.dev.ts
**/*.dev.tsx

# --- Dev-only Sentry manual-verification screen (also __DEV__-guarded) ---
app/dev-sentry-test.tsx
